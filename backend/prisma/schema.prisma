generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  in_progress
  done
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace[]
  //categories Category[]

  @@map("users")
}

model Workspace {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  userId      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  tasks Task[]

  @@map("workspace")
}

model Task {
  id          Int        @id @default(autoincrement())
  workspaceId Int
  name        String
  description String?
  status      TaskStatus @default(todo)
  start_date  DateTime?
  due_date    DateTime?
  all_day     Boolean?   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("task")
}
